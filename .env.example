# Backend Environment Variables (.env)
# STRICTLY SERVER-ONLY - NEVER EXPOSE TO CLIENT BUNDLES

# -----------------------------------------------------------------------------
# Supabase Configuration (Server Service Role)
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
# Administrative service role key for bypassing RLS to persist ingestion data
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here
# Optional: direct database connection string
DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres

# -----------------------------------------------------------------------------
# AI Classification / Gemini API
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_PROMPT_VERSION=v2.2.0

# -----------------------------------------------------------------------------
# Ingestion & System Settings
# -----------------------------------------------------------------------------
NODE_ENV=production
# Secret key to authenticate Vercel Cron requests (Bearer token or x-cron-secret)
CRON_SECRET=your_secure_cron_secret_here

# Frontend domain for CORS configuration
FRONTEND_URL=https://your-frontend.vercel.app

# Optional server port for local development standalone server
API_PORT=4000
